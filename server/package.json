{
  "name": "server",
  "version": "0.0.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "npm run clean && nest build",
    "clean": "rimraf dist",
    "check": "npm run format:all && npm run lint:ci && npm run test:ci && npm run build",
    "format": "onchange \"**/*\" -- prettier --write --ignore-unknown {{changed}}",
    "format:all": "npx prettier --write .",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:ci": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "start": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.config.json --colors --coverage --watchAll",
    "test:ci": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.config.json --ci --colors",
    "test:e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/authorization": "^0.1.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/platform-socket.io": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/typeorm": "^12.0.2",
    "@nestjs/websockets": "^12.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "firebase-admin": "^13.7.0",
    "helmet": "^8.1.0",
    "mysql2": "^3.15.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.30"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.5.2",
    "onchange": "^7.1.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.4",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.20.0"
  }
}
